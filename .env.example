# Next.js (.env.local). `npx convex dev` fills in the CONVEX_* values.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# -----------------------------------------------------------------------------
# The variables below are NOT read from this file. Set them on the Convex
# deployment with `npx convex env set NAME value` (see README).
#
# CLERK_JWT_ISSUER_DOMAIN       Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
# APP_URL                       Public URL of this app, used for links in notifications
# N8N_LOAN_EVENTS_WEBHOOK_URL   e.g. http://localhost:5678/webhook/lendloop/loan-events
# N8N_WEBHOOK_SIGNING_SECRET    signs Convex → n8n webhooks   (openssl rand -hex 32)
# N8N_CALLBACK_SIGNING_SECRET   verifies n8n → Convex calls   (openssl rand -hex 32)
