# Copy to n8n/.env (git-ignored). Generate secrets with: openssl rand -hex 32

# Encrypts credentials stored in n8n's database. Keep it stable.
N8N_ENCRYPTION_KEY=

# Verifies webhooks FROM Convex. Must equal Convex's N8N_WEBHOOK_SIGNING_SECRET.
LENDLOOP_WEBHOOK_SECRET=

# Signs callbacks TO Convex. Must equal Convex's N8N_CALLBACK_SIGNING_SECRET.
LENDLOOP_CALLBACK_SECRET=

# Convex HTTP actions URL as seen from inside the container.
# Local Convex backend: http://host.docker.internal:3211
# Convex cloud:         https://<deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211
